# Normalizza i fine riga: nel repository sempre LF.
* text=auto

# File che devono restare LF anche su Windows (girano su Linux, o ne dipende il checksum).
*.sql text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.cnf text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
deploy/cron/* text eol=lf
deploy/logrotate/* text eol=lf
# Testo ufficiale della licenza e avviso: identici byte per byte all'originale anche su Windows.
LICENSE text eol=lf
NOTICE text eol=lf
