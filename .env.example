# Copia questo file in .env e adatta i valori. Il file .env NON va mai committato.

APP_NAME=LogiDock
# local | production
APP_ENV=local
# In produzione deve essere false: con true l'utente vede i dettagli degli errori.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Rome

# Minuti di inattività dopo i quali la sessione scade.
SESSION_LIFETIME_MINUTES=120

# Percorso del file di log, relativo alla radice del progetto.
LOG_PATH=storage/logs/app.log

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logidock
DB_USER=logidock
DB_PASSWORD=cambiami

# Password degli utenti di esempio creati da "php bin/seed.php" (solo sviluppo).
# Il seed si rifiuta di girare se queste due variabili sono vuote, se non rispettano le regole delle
# password (almeno 12 caratteri, niente spazi all'inizio o alla fine) o con APP_ENV=production.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
